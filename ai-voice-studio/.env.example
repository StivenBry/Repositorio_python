# ==========================================================================
#  AI VOICE STUDIO - Ejemplo de configuracion
#  Copia este archivo como `.env` y rellena solo lo que vayas a usar.
#      cp .env.example .env
#
#  IMPORTANTE: `.env` esta en .gitignore. Nunca subas claves al repositorio
#  y nunca las escribas en el codigo del navegador (frontend).
#  La aplicacion ARRANCA Y FUNCIONA sin ninguna clave usando los
#  proveedores offline (`mock` para voz y `heuristic` para IA).
# ==========================================================================

# --------------------------------------------------------------------------
# 1. SERVIDOR
# --------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Origenes permitidos para CORS, separados por coma. Vacio = mismo origen.
CORS_ORIGINS=

# --------------------------------------------------------------------------
# 2. LIMITES Y SEGURIDAD
# --------------------------------------------------------------------------
# Maximo de caracteres aceptados en un guion (protege coste y memoria).
MAX_SCRIPT_CHARS=8000
# Maximo de caracteres para el boton "Probar voz".
MAX_PREVIEW_CHARS=320
# Ventana y cupo del limitador de peticiones por IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Cupo especifico para operaciones caras (generar audio / llamar a la IA).
RATE_LIMIT_HEAVY_MAX=15

# --------------------------------------------------------------------------
# 3. MOTOR DE VOZ (TTS)
#    Valores: mock | elevenlabs | openai | google | azure
#    `mock` no necesita clave: sintetiza un audio de referencia offline
#    (respeta ritmo, pausas y enfasis) para probar el flujo completo.
# --------------------------------------------------------------------------
TTS_PROVIDER=mock
# Idioma con el que se filtra el catalogo de voces (Google y Azure devuelven
# cientos). Formato BCP-47: es-ES, es-CO, es-MX, en-US...
TTS_LANGUAGE=es-ES

# --- ElevenLabs (DE PAGO, con plan gratuito limitado) ---------------------
# Consigue la clave en https://elevenlabs.io -> Profile -> API Key
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- OpenAI TTS (DE PAGO, por caracteres) ---------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Google Cloud Text-to-Speech (DE PAGO, con cuota gratuita mensual) -----
# Crea una API key restringida a "Cloud Text-to-Speech API" en
# https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE=es-ES

# --- Microsoft Azure Speech (DE PAGO, con capa gratuita F0) ----------------
# https://portal.azure.com -> Speech service -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --------------------------------------------------------------------------
# 4. MOTOR DE IA (analisis e interpretacion del guion)
#    Valores: heuristic | anthropic | openai | google
#    `heuristic` es el motor propio incluido: funciona sin clave y sin
#    conexion. Los demas mejoran la calidad del analisis y del optimizador.
# --------------------------------------------------------------------------
AI_PROVIDER=heuristic

# --- Anthropic Claude (DE PAGO) -------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (DE PAGO) ------------------------------------------------------
# Reutiliza OPENAI_API_KEY definido arriba.
OPENAI_AI_MODEL=gpt-4o-mini

# --- Google Gemini (DE PAGO, con capa gratuita) ---------------------------
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# --------------------------------------------------------------------------
# 5. ALMACENAMIENTO
#    local  -> disco del servidor (carpeta STORAGE_DIR)
#    memory -> solo memoria RAM, util para pruebas o entornos efimeros
# --------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./data
# Horas que se conservan los audios generados antes de borrarse.
AUDIO_RETENTION_HOURS=72

# --------------------------------------------------------------------------
# 6. AUDIO
# --------------------------------------------------------------------------
# Formato preferido de descarga: mp3 | wav
DEFAULT_AUDIO_FORMAT=mp3
# Ruta a ffmpeg si no esta en el PATH (opcional; mejora las conversiones).
FFMPEG_PATH=
