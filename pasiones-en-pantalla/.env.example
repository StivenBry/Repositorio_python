# ---------------------------------------------------------------------------
# Pasiones en Pantalla · Variables de entorno
# Copia este archivo como .env.local (desarrollo) o pégalas en Vercel/Netlify.
# Sin estas variables la app funciona en MODO DEMO (datos en el navegador).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → "anon public" (o "publishable")
# Es pública por diseño: la seguridad la dan las políticas RLS de schema.sql.
# ¡Nunca uses aquí la clave "service_role" / "secret"!
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON

# Opcional: nombre del bucket de Storage (por defecto "media")
VITE_SUPABASE_BUCKET=media

# Opcional: URL pública del sitio para las vistas previas en redes sociales
# (en Vercel y Netlify se detecta sola).
# VITE_SITE_URL=https://pasiones.tudominio.com

# Opcional: Google AdSense. Sin estas variables no se carga nada de publicidad.
# ID de editor (AdSense → Cuenta → Información de la cuenta) y bloque de anuncio
# "Display" adaptable (AdSense → Anuncios → Por bloque de anuncios → data-ad-slot).
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=0000000000

# Opcional: Adsterra. Pega el src del script de cada formato ("Get code").
# El Native Banner y el banner muestran su anuncio en los espacios de publicidad;
# Popunder y Social Bar funcionan en todo el sitio (nunca en /admin).
# VITE_ADSTERRA_POPUNDER=https://dominio-de-adsterra/1/0123456789abcdef0123456789abcdef
# VITE_ADSTERRA_SOCIAL_BAR=https://dominio-de-adsterra/14/0123456789abcdef0123456789abcdef
# VITE_ADSTERRA_NATIVE=https://dominio-de-adsterra/21/0123456789abcdef0123456789abcdef
# VITE_ADSTERRA_BANNER=https://dominio-de-adsterra/22/0123456789abcdef0123456789abcdef
# VITE_ADSTERRA_BANNER_SIZE=468x60
# VITE_ADSTERRA_SMARTLINK=https://dominio-de-adsterra/4/0123456789abcdef0123456789abcdef
