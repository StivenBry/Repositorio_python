# Copia este archivo a .env y rellena solo lo que uses. Todo es opcional:
# las claves de IA (Gemini, fal.ai, ElevenLabs, Upload-Post) también se pueden
# pegar en Ajustes del panel, que las guarda cifradas en tu navegador.

# ---------------------------------------------------------------------------
# Límites: en esta copia todos están desactivados por defecto (0 = sin límite).
# Descomenta una línea solo si quieres volver a poner ese límite.
# ---------------------------------------------------------------------------

# Tamaño máximo de un vídeo subido, en MB. El original lo fijaba en 2048 (2 GB).
# MAX_FILE_SIZE_MB=0

# Segundos que se guardan los trabajos y las subidas antes de borrarse solos.
# El original los borraba a las 24 h (86400). 0 = se guardan hasta que los borres.
# JOB_RETENTION_SECONDS=0
# Solo la descarga original de un trabajo por URL, si la quieres borrar antes.
# SOURCE_RETENTION_SECONDS=0

# Tope de disco: al superarlo se borran los trabajos/subidas más antiguos.
# El original usaba 25 GB y 15 GB. 0 = sin tope.
# OUTPUT_MAX_GB=0
# UPLOADS_MAX_GB=0

# Duración mínima del vídeo de origen, en segundos. El original rechazaba los
# de menos de 45 s. 0 = acepta cualquier duración.
# MIN_SOURCE_SECONDS=0

# Editor de clips: número máximo de tramos y duración máxima del clip editado.
# El original: 12 tramos y 180 s. 0 = sin tope.
# RECUT_MAX_SEGMENTS=0
# RECUT_MAX_TOTAL_SECONDS=0

# Herramientas gratuitas (transcripción y metadatos de YouTube): el original
# limitaba las peticiones por IP y por día. Pon 1 si expones el servidor a
# internet y quieres ese límite de vuelta.
# FREE_TOOLS_RATE_LIMIT=0

# ---------------------------------------------------------------------------
# Rendimiento (no son límites: lo que no cabe espera en la cola)
# ---------------------------------------------------------------------------

# Trabajos procesándose a la vez. Súbelo si tienes RAM/VRAM de sobra.
# MAX_CONCURRENT_JOBS=5

# Modelo de transcripción. "small" va mejor que "base" fuera del inglés.
# Con GPU NVIDIA: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# whisper (por defecto) | parakeet (solo imagen GPU, ~2x más rápido, 25 idiomas
# europeos; vuelve a whisper si falla).
# TRANSCRIBE_BACKEND=whisper
# ASR_GPU_CONCURRENCY=1

# Codificador de vídeo: x264 (por defecto) | nvenc | auto (prueba NVENC al arrancar).
# FFMPEG_ENCODER=x264

# ---------------------------------------------------------------------------
# IA
# ---------------------------------------------------------------------------

# Clave de Gemini para el servidor (si no la pones en el panel).
# GEMINI_API_KEY=

# Modelos de Gemini para Thumbnail Studio (títulos e imágenes).
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Elegir momentos con tu propio modelo en vez de Gemini (Ollama, LM Studio,
# vLLM, llama.cpp, LocalAI, OpenRouter...). Con esto la clave de Gemini pasa a
# ser opcional; si está, se sigue usando para lo que mira fotogramas.
# Ollama necesita más contexto que su valor por defecto: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600

# ---------------------------------------------------------------------------
# Descargas, copias y publicación
# ---------------------------------------------------------------------------

# Cookies de YouTube en formato Netscape, si YouTube pide "confirmar que no eres un bot".
# YOUTUBE_COOKIES=...

# Aviso previo si el vídeo de YouTube no llega a esta altura (0 lo desactiva).
# Solo avisa y te deja seguir; no es un límite.
# QUALITY_GATE_MIN_HEIGHT=720

# AWS S3 (opcional: copia de los clips y galería pública).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-3
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_BUCKET=

# URL pública del API, para los enlaces absolutos de los webhooks.
# PUBLIC_API_URL=http://localhost:8000

# Analítica propia (OpenPanel), desactivada si no se define. Se lee al compilar el panel.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=
